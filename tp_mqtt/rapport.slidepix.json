          "shape": "rectangle",
          "fill": "#eaf1f2"
        },
        {
          "id": "p1-architecture",
          "morphKey": "p1-architecture",
          "x": 131,
          "y": 618,
          "width": 980,
          "height": 46,
          "rotation": 0,
          "opacity": 1,
          "z": 1,
          "locked": false,
          "hidden": false,
          "type": "text",
          "markdown": "Robots EV3 ou simulateur  ↔  Broker MQTT  ↔  Node-RED",
          "style": {
            "fontFamily": "Palatino, \"Palatino Linotype\", \"Times New Roman\", Times, serif",
            "fontSize": 32,
            "fontWeight": 600,
            "color": "#254e5c",
