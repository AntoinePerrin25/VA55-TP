          "type": "text",
          "markdown": "2 · Délimitation du croisement",
          "style": {
            "fontFamily": "Palatino, \"Palatino Linotype\", \"Times New Roman\", Times, serif",
            "fontSize": 33,
            "fontWeight": 600,
            "color": "#254e5c",
