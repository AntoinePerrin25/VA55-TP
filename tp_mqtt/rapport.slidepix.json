          "x": 131,
          "y": 680,
          "width": 980,
          "height": 72,
          "rotation": 0,
          "opacity": 1,
          "z": 1,
          "locked": false,
          "hidden": false,
          "type": "text",
          "markdown": "Les robots publient leur état. Node-RED décide qui passe. La vue du huit affiche les positions, les zones et le droit en cours.",
