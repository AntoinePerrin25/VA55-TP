            "lineHeight": 1.31,
            "padding": 0
          }
        },
        {
          "id": "p2-rayons",
          "morphKey": "p2-rayons",
          "x": 100,
          "y": 553,
          "width": 1040,
          "height": 394,
          "rotation": 0,
          "opacity": 1,
          "z": 1,
          "locked": false,
          "hidden": false,
          "type": "table",
          "rows": 6,
          "columns": 2,
          "cells": [
            [
              "Rayon",
              "Action ou limite"
            ],
            [
              "720 mm",
              "Annoncer l’approche"
            ],
            [
              "560 mm",
              "S’arrêter ici si le droit manque"
            ],
            [
              "480 mm",
              "Début de la zone de stockage"
            ],
            [
              "220 mm",
              "Limite de la zone de conflit"
            ],
            [
              "320 mm",
              "Signaler la libération après la traversée"
            ]
          ],
          "headerRow": true,
          "style": {
            "fontFamily": "Palatino, \"Palatino Linotype\", \"Times New Roman\", Times, serif",
