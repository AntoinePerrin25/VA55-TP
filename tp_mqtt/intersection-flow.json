    {
        "id": "fn_light",
        "type": "function",
        "z": "tab_intersection",
        "name": "voie libre si le disque est vide",
        "func": "const body = msg.payload || {};\nconst states = flow.get(\"states\") || {};\nif (body.id) {\n    states[body.id] = body.zone || \"\";\n    flow.set(\"states\", states);\n}\nconst ids = Object.keys(states);\nconst inside = ids.filter((id) => states[id] === \"conflit\");\nif (inside.length === 0) {\n    msg.payload = {\n        phase: \"open\",\n        green: ids.length ? ids : [\"A\", \"B\"],\n        all_red: false,\n        occupied_by: null\n    };\n} else {\n    msg.payload = {\n        phase: \"occupied\",\n        green: inside,\n        all_red: false,\n        occupied_by: inside[0]\n    };\n}\nmsg.qos = 1;\nmsg.retain = true;\nnode.status({\n    fill: inside.length ? \"red\" : \"green\",\n    shape: \"dot\",\n    text: inside.length ? (\"occupé \" + inside.join(\", \")) : \"voie libre\"\n});\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 140,
        "wires": [
            [
                "mqtt_phase",
                "dbg_phase"
            ]
        ]
    },
    {
        "id": "mqtt_phase",
        "type": "mqtt out",
        "z": "tab_intersection",
