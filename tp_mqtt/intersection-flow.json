    {
        "id": "fn_zones",
        "type": "function",
        "z": "tab_intersection",
        "name": "changement de zone",
        "func": "const body = msg.payload || {};\nconst id = body.id || \"?\";\nconst zones = flow.get(\"zones\") || {};\nconst changed = zones[id] !== body.zone;\nzones[id] = body.zone;\nflow.set(\"zones\", zones);\nnode.status({\n    fill: body.zone === \"conflit\" ? \"red\" : (body.speed_mm_s > 1 ? \"green\" : \"yellow\"),\n    shape: \"dot\",\n    text: id + \" \" + (body.zone || \"\") + \" \" + Math.round(body.speed_mm_s || 0) + \" mm/s\"\n});\nif (!changed) return null;\nmsg.payload = id + \" → \" + body.zone;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 280,
        "wires": [
            [
                "dbg_zone"
            ]
        ]
    },
